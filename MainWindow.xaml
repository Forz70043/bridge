<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bridge"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bridge">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="#1a1a1a">
            <!-- Drag region: full width minus ? button + system caption buttons (margin set from code) -->
            <Grid x:Name="TitleBarDragArea">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="12,0,0,0">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="#4e94ff"/>
                    <TextBlock Text="Bridge" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <!-- ? Help button: positioned before system caption buttons (right margin set from code) -->
            <Button x:Name="HelpButton"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="30" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#888" FontSize="14" FontWeight="SemiBold"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind local:Localizer.Help, Mode=OneWay}">
                <Button.Content>
                    <FontIcon Glyph="&#xE897;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                </Button.Content>
                <Button.Flyout>
                    <MenuFlyout x:Name="HelpFlyout" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="AboutMenuItem" Click="TitleBarAbout_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Padding="20" Spacing="15" Background="#1a1a1a">
            <TextBox x:Name="SearchBox" PlaceholderText="Search wsl..." Width="300" Background="#252525" BorderThickness="0" TextChanged="SearchBox_TextChanged"/>
            <ToggleSwitch x:Name="OnlyRunningToggle" OnContent="Only running" OffContent="Show all" IsOn="False" Toggled="OnlyRunning_Toggled" VerticalAlignment="Center"/>

            <!-- Pulsante di test toast -->
            <Button Content="Test Toast" Click="TestToast_Click" VerticalAlignment="Center" />

            <!-- Status operazione top -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                <ProgressRing x:Name="TopOperationRing" IsActive="False" Visibility="Collapsed" Width="20" Height="20" />
                <TextBlock x:Name="TopOperationText" Text="" Foreground="#fff" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>

            <CommandBar Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                <AppBarButton Icon="Delete" Label="Delete" Foreground="#ff5555" Click="TopDelete_Click"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Play" Foreground="#4e94ff" Click="TopPlay_Click"/>
                <AppBarButton Icon="Stop" Foreground="#4e94ff" Click="TopStop_Click"/>

                <!-- Nuovi bottoni: Export e Import -->
                <AppBarSeparator/>
                <AppBarButton Icon="Save" Label="Export" Foreground="#4e94ff" Click="TopExport_Click"/>
                <AppBarButton Icon="OpenFile" Label="Import" Foreground="#4e94ff" Click="TopImport_Click"/>
            </CommandBar>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="DistroList" Padding="10" SelectionMode="Multiple">
            <ListView.Header>
                <Grid Padding="15,10" Background="#1a1a1a" BorderBrush="#333" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Grid.Column="1" Foreground="#888" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Status" Grid.Column="2" Foreground="#888" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Version" Grid.Column="3" Foreground="#888" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="Actions" Grid.Column="4" Foreground="#888" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WslDistro">
                    <Grid Padding="10,5" BorderBrush="#222" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" Foreground="{x:Bind StatusColor, Mode=OneWay}" FontSize="12"/>

                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Grid.Column="1" VerticalAlignment="Center" FontWeight="Medium"/>
                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Grid.Column="2" VerticalAlignment="Center" Foreground="#aaa"/>
                        <TextBlock Text="{x:Bind Version, Mode=OneWay}" Grid.Column="3" VerticalAlignment="Center" Foreground="#aaa"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Click="Terminal_Click" ToolTipService.ToolTip="Open Terminal"/>
                            <Button Content="" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Foreground="#4e94ff" Click="Stop_Click"/>
                            <Button Content="" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Foreground="#ff5555" Click="Delete_Click"/>
                            <!-- Settings per-distro -->
                            <Button Content="⚙" FontFamily="Segoe UI Symbol" Background="Transparent" BorderThickness="0" Foreground="#cccccc" Click="Settings_Click" ToolTipService.ToolTip="Settings" />
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind BusyVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"/>

            <!-- In-app toast container (stack of transient messages) -->
            <StackPanel x:Name="ToastPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16" IsHitTestVisible="False" />
        </Grid>
    </Grid>




</Window>
