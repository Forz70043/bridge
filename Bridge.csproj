<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Bridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>

    <!-- Assembly metadata (shown in file Properties → Details and UAC prompt) -->
    <Product>Bridge</Product>
    <Company>Alfonso Pisicchio</Company>
    <Authors>Alfonso Pisicchio</Authors>
    <Description>Native WSL manager for Windows</Description>
    <Copyright>© 2025 Alfonso Pisicchio</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- Tray icon implemented via Win32 Shell_NotifyIcon; do not enable Windows Forms -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged mode required for PublishSingleFile support -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained: bundle the Windows App SDK runtime (no separate runtime install needed) -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- DeploymentManager requires package identity (MSIX) — must be false for unpackaged apps -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <!-- Unpackaged WinUI 3 expects PRI file named "resources.pri" (not "Bridge.pri") -->
    <PriIndexName></PriIndexName>
    <Nullable>enable</Nullable>
    <!-- Disable implicit PRIResource items so we can include Strings\**\*.resw explicitly -->
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\BadgeLogo.scale-200.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\BadgeLogo.scale-200.png" />
    <Content Include="Assets\linux_image_transparent.jpg" />
    <Content Include="Assets\linux_image_transparent.png" />
    <Content Include="Assets\Icons\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include=".github\workflows\validate-resw.yml" />
  </ItemGroup>
  <!-- Include RESW localization resources automatically -->
  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Assets\Icons\.gitkeep" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Use ICO generated from linux_image_transparent.jpg for ApplicationIcon -->
  <ItemGroup>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <!-- Application icon: Assets\Icons\app.ico is generated from Assets\linux_image_transparent.jpg (see repository documentation for generation steps) -->
  </PropertyGroup>

  <!-- Unpackaged WinUI 3 requires "resources.pri" next to the exe.
       The self-contained targets set PriIndexName to empty which should produce it,
       but as a safety net, copy Bridge.pri → resources.pri after build/publish. -->
  <Target Name="EnsureResourcesPri" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(OutputPath)\Bridge.pri"
          DestinationFiles="$(OutputPath)\resources.pri"
          Condition="Exists('$(OutputPath)\Bridge.pri') and !Exists('$(OutputPath)\resources.pri')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PublishDir)\Bridge.pri"
          DestinationFiles="$(PublishDir)\resources.pri"
          Condition="'$(PublishDir)'!='' and Exists('$(PublishDir)\Bridge.pri') and !Exists('$(PublishDir)\resources.pri')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>